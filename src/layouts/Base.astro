---
import { site, whatsappLink } from '../config';
import Icon from '../components/Icon.astro';
import '../styles/global.css';
import '../styles/ssab-inspired.css';
const { title, description, canonical = Astro.url.pathname, image = '/og-default.svg' } = Astro.props;
const fullTitle = title === site.name ? title : `${title} | ${site.name}`;
const pageClass = `page-${Astro.url.pathname.replace(/^\//, '').replace(/\/$/, '').replace(/[^a-z0-9]+/gi, '-') || 'home'}`;
const wa = whatsappLink({interest:'produtos e soluções em aço',page:Astro.url.pathname,position:'botão flutuante',code:'SITE-FLOAT-GERAL'});
const jsonLd = { '@context':'https://schema.org','@type':'Organization',name:site.name,url:site.domain,email:site.email,telephone:site.phoneDisplay,address:{'@type':'PostalAddress',streetAddress:'Rua João Simões de Carvalho, 201-A, Bloco B',addressLocality:'Cambuí',addressRegion:'MG',postalCode:site.postalCode,addressCountry:'BR'} };
---
<!doctype html><html lang="pt-BR"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width"><title>{fullTitle}</title>
<meta name="description" content={description}><link rel="canonical" href={new URL(canonical,site.domain)}>
<meta property="og:title" content={fullTitle}><meta property="og:description" content={description}><meta property="og:type" content="website"><meta property="og:url" content={new URL(canonical,site.domain)}><meta property="og:image" content={new URL(image,site.domain)}>
<meta name="theme-color" content="#142758"><link rel="icon" href="/favicon.ico" sizes="any"><script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head><body class={pageClass}>
<a class="skip" href="#conteudo">Pular para o conteúdo</a>
<header class="site-header">
  <div class="topbar"><div class="container">
    <a class="topbar-contact" href={site.phoneHref}><Icon name="phone" size={15} /> Ligue: <strong>{site.phoneDisplay}</strong></a>
    <div class="topbar-channels">
      <a class="social-link topbar-whatsapp" href={wa} target="_blank" rel="noopener" aria-label="WhatsApp do Grupo ABR"><Icon name="whatsapp" size={17} brand /></a>
      <a class="social-link" href={site.instagram} target="_blank" rel="noopener" aria-label="Instagram do Grupo ABR"><Icon name="instagram" size={16} brand /></a>
      <a class="social-link" href={site.facebook} target="_blank" rel="noopener" aria-label="Facebook do Grupo ABR"><Icon name="facebook" size={16} brand /></a>
      <a class="social-link" href={site.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn do Grupo ABR"><Icon name="linkedin" size={16} brand /></a>
    </div>
  </div></div>
  <div class="nav-wrap"><div class="container nav">
    <a class="brand" href="/" aria-label="Grupo ABR — início"><img src="/brand/grupo-abr-logo-branca.svg" alt="Grupo ABR — Seu Parceiraço" width="130" height="76"></a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="main-nav"><Icon name="menu" size={21} /><span>Menu</span></button>
    <nav id="main-nav" aria-label="Principal">
      <a href="/empresa/">Empresa</a>
      <details>
        <summary>Produtos e Soluções</summary>
        <div class="mega products-menu">
          <a href="/produtos/bobininha-slitada/">Bobininha Slitada</a>
          <a href="/produtos/bobina-slitada/">Bobina Slitada</a>
          <a href="/produtos/chapas-de-aco/">Chapas de Aço</a>
          <a href="/produtos/laminados/">Laminados</a>
          <a href="/produtos/malha/">Malha</a>
          <a href="/produtos/perfil-estrutural/">Perfil Estrutural</a>
          <a href="/produtos/telhas/">Telhas</a>
          <a href="/produtos/trelica/">Treliça</a>
          <a href="/produtos/tubos-e-metalons/">Tubos e Metalons</a>
          <a href="/produtos/vergalhao/">Vergalhão</a>
          <a href="/produtos/viga-w-e-i/">Viga W e I</a>
        </div>
      </details>
      <details>
        <summary>Tour ABR</summary>
        <div class="mega compact">
          <a href="https://tourbrasil360.com/fabrica/grupo-abr/" target="_blank" rel="noopener">Unidade – Cambuí MG</a>
          <a href="https://tourbrasil360.com/fabrica/grupo-abr/pinheiral/" target="_blank" rel="noopener">Unidade – Pinheiral RJ</a>
        </div>
      </details>
      <details>
        <summary>Fale Conosco</summary>
        <div class="mega compact">
          <a href="/contato/">Contato</a>
          <a href={whatsappLink({interest:'uma cotação',page:'menu principal',position:'submenu fale conosco',code:'SITE-MENU-ORCAMENTO'})} target="_blank" rel="noopener">Orçamento</a>
          <a href="/trabalhe-conosco/">Trabalhe Conosco</a>
          <a href="/seja-um-parceiraco/">Seja um Parceiraço!</a>
        </div>
      </details>
      <a href="/produtos/abr-solar/">ABR Solar</a>
    </nav>
    <a class="button nav-cta" href={whatsappLink({interest:'uma cotação',page:'menu principal',position:'cabeçalho',code:'SITE-HEADER-COTAR'})} target="_blank" rel="noopener">Solicitar orçamento</a>
  </div></div>
</header>
<main id="conteudo"><slot /></main>
<footer><div class="container footer-grid"><div><a class="brand inverse" href="/"><img src="/brand/grupo-abr-logo-branca.svg" alt="Grupo ABR — Seu Parceiraço" width="150" height="87"></a><p>Força para construir. Agilidade para entregar. Parceria para crescer.</p></div><div><h2>Produtos</h2><a href="/produtos/telhas/">Telhas</a><a href="/produtos/bobina-slitada/">Bobina Slitada</a><a href="/produtos/laminados/">Laminados</a><a href="/produtos/abr-solar/">ABR Solar</a></div><div><h2>Grupo ABR</h2><a href="/empresa/">Empresa</a><a href="/blog/">Blog</a><a href="/downloads/">Downloads</a><a href="/trabalhe-conosco/">Trabalhe conosco</a><a href="/seja-um-parceiraco/">Seja um Parceiraço</a></div><div><h2>Fale conosco</h2><a href={site.phoneHref}>{site.phoneDisplay}</a><a href={`mailto:${site.email}`}>{site.email}</a><p>{site.address}<br>CEP {site.postalCode}</p></div></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} Grupo ABR. Todos os direitos reservados.</span><span><a href="/politica-de-privacidade/">Privacidade</a> · <a href="/politica-de-cookies/">Cookies</a></span></div></footer>
<a class="float-wa" href={wa} target="_blank" rel="noopener" aria-label="Falar com o Grupo ABR pelo WhatsApp"><Icon name="whatsapp" size={28} brand /></a>
<script>
  const btn=document.querySelector('.menu-toggle'); const nav=document.querySelector('#main-nav'); btn?.addEventListener('click',()=>{const open=btn.getAttribute('aria-expanded')==='true';btn.setAttribute('aria-expanded',String(!open));nav?.classList.toggle('open',!open)});

  const hoverNavigation=window.matchMedia('(hover: hover) and (pointer: fine)');
  const dropdowns=[...document.querySelectorAll<HTMLDetailsElement>('#main-nav > details')];
  dropdowns.forEach(dropdown=>{
    let closeTimer:number|undefined;
    const openDropdown=()=>{
      window.clearTimeout(closeTimer);
      dropdowns.forEach(item=>{
        if(item!==dropdown){item.classList.remove('is-visible');item.open=false}
      });
      dropdown.open=true;
      window.requestAnimationFrame(()=>dropdown.classList.add('is-visible'));
    };
    const closeDropdown=(keepForFocus=true)=>{
      window.clearTimeout(closeTimer);
      const isActive=()=>dropdown.matches(':hover')||(keepForFocus&&dropdown.matches(':focus-within'));
      if(!isActive())dropdown.classList.remove('is-visible');
      closeTimer=window.setTimeout(()=>{
        if(!isActive())dropdown.open=false;
      },320);
    };

    dropdown.addEventListener('pointerenter',()=>{if(hoverNavigation.matches)openDropdown()});
    dropdown.addEventListener('pointerleave',()=>{if(hoverNavigation.matches)closeDropdown(false)});
    dropdown.addEventListener('focusin',()=>{if(hoverNavigation.matches)openDropdown()});
    dropdown.addEventListener('focusout',()=>closeDropdown(true));
    dropdown.addEventListener('toggle',()=>{
      if(!dropdown.open)dropdown.classList.remove('is-visible');
      else window.requestAnimationFrame(()=>dropdown.classList.add('is-visible'));
    });
    dropdown.querySelector('summary')?.addEventListener('click',event=>{
      if(hoverNavigation.matches&&event.detail>0)event.preventDefault();
    });
  });
  document.addEventListener('click',e=>{const a=(e.target as Element).closest('a');if(!a)return; if(a.href.includes('wa.me')) window.dataLayer?.push({event:'whatsapp_click',page_path:location.pathname,cta_code:new URL(a.href).searchParams.get('text')?.match(/Código: ([^.]+)/)?.[1]||'unknown'}); if(a.href.startsWith('tel:')) window.dataLayer?.push({event:'phone_click',page_path:location.pathname});});
  declare global { interface Window { dataLayer?: Record<string,unknown>[] } }
</script>
<script>
  if(location.pathname==='/empresa/'||location.pathname==='/empresa'){const art=document.querySelector<HTMLElement>('.industrial-art');if(art){const video=document.createElement('div');video.className='institutional-video';video.innerHTML='<iframe src="https://www.youtube.com/embed/OZMYY4WcHbk?start=3&rel=0" title="Vídeo institucional do Grupo ABR" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>';art.replaceWith(video);}}
</script>
</body></html>

---
import { site, whatsappLink } from '../config';
import Icon from '../components/Icon.astro';
import '../styles/global.css';
import '../styles/ssab-inspired.css';
const { title, description, canonical = Astro.url.pathname, image = '/og-default.svg' } = Astro.props;
const fullTitle = title === site.name ? title : `${title} | ${site.name}`;
const wa = whatsappLink({interest:'produtos e soluções em aço',page:Astro.url.pathname,position:'botão flutuante',code:'SITE-FLOAT-GERAL'});
const jsonLd = { '@context':'https://schema.org','@type':'Organization',name:site.name,url:site.domain,email:site.email,telephone:site.phoneDisplay,address:{'@type':'PostalAddress',streetAddress:'Rua João Simões de Carvalho, 201-A, Bloco B',addressLocality:'Cambuí',addressRegion:'MG',postalCode:site.postalCode,addressCountry:'BR'} };
---
<!doctype html><html lang="pt-BR"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width"><title>{fullTitle}</title>
<meta name="description" content={description}><link rel="canonical" href={new URL(canonical,site.domain)}>
<meta property="og:title" content={fullTitle}><meta property="og:description" content={description}><meta property="og:type" content="website"><meta property="og:url" content={new URL(canonical,site.domain)}><meta property="og:image" content={new URL(image,site.domain)}>
<meta name="theme-color" content="#142758"><link rel="icon" href="/favicon.svg" type="image/svg+xml"><script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head><body>
<a class="skip" href="#conteudo">Pular para o conteúdo</a>
<header class="site-header">
  <div class="topbar"><div class="container">
    <a class="topbar-contact" href={site.phoneHref}><Icon name="phone" size={15} /> Ligue: <strong>{site.phoneDisplay}</strong></a>
    <div class="topbar-channels">
      <a class="topbar-contact topbar-whatsapp" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" size={16} brand /><span class="contact-label">WhatsApp {site.whatsappDisplay}</span></a>
      <span class="social-label">Siga o Grupo ABR</span>
      <a class="social-link" href={site.instagram} target="_blank" rel="noopener" aria-label="Instagram do Grupo ABR"><Icon name="instagram" size={16} brand /></a>
      <a class="social-link" href={site.facebook} target="_blank" rel="noopener" aria-label="Facebook do Grupo ABR"><Icon name="facebook" size={16} brand /></a>
    </div>
  </div></div>
  <div class="nav-wrap"><div class="container nav"><a class="brand" href="/" aria-label="Grupo ABR — início"><img src="/brand/grupo-abr-logo-branca.svg" alt="Grupo ABR — Seu Parceiraço" width="130" height="76"></a><button class="menu-toggle" aria-expanded="false" aria-controls="main-nav"><Icon name="menu" size={21} /><span>Menu</span></button><nav id="main-nav" aria-label="Principal"><a href="/empresa/">Empresa</a><details><summary>Produtos e soluções</summary><div class="mega"><a href="/produtos/">Ver catálogo</a><a href="/produtos/telhas-e-coberturas/">Telhas e coberturas</a><a href="/produtos/bobinas-e-chapas/">Bobinas e chapas</a><a href="/produtos/acos-longos-e-laminados/">Aços longos</a><a href="/produtos/perfis-estruturais/">Perfis estruturais</a><a href="/produtos/tubos-e-metalons/">Tubos e metalons</a><a href="/produtos/abr-solar/">ABR Solar</a></div></details><details><summary>Conteúdos</summary><div class="mega compact"><a href="/blog/">Blog</a><a href="/downloads/">Downloads</a><a href="/obras-e-aplicacoes/">Obras e aplicações</a></div></details><a href="/tour-abr/">Tour ABR</a><a href="/contato/">Contato</a></nav><a class="button nav-cta" href={whatsappLink({interest:'uma cotação',page:'menu principal',position:'cabeçalho',code:'SITE-HEADER-COTAR'})} target="_blank" rel="noopener">Solicitar orçamento</a></div></div>
</header>
<main id="conteudo"><slot /></main>
<footer><div class="container footer-grid"><div><a class="brand inverse" href="/"><img src="/brand/grupo-abr-logo-branca.svg" alt="Grupo ABR — Seu Parceiraço" width="150" height="87"></a><p>Força para construir. Agilidade para entregar. Parceria para crescer.</p></div><div><h2>Produtos</h2><a href="/produtos/telhas-e-coberturas/">Telhas e coberturas</a><a href="/produtos/bobinas-e-chapas/">Bobinas e chapas</a><a href="/produtos/acos-longos-e-laminados/">Aços longos</a><a href="/produtos/abr-solar/">ABR Solar</a></div><div><h2>Grupo ABR</h2><a href="/empresa/">Empresa</a><a href="/blog/">Blog</a><a href="/downloads/">Downloads</a><a href="/trabalhe-conosco/">Trabalhe conosco</a><a href="/seja-um-parceiraco/">Seja um Parceiraço</a></div><div><h2>Fale conosco</h2><a href={site.phoneHref}>{site.phoneDisplay}</a><a href={`mailto:${site.email}`}>{site.email}</a><p>{site.address}<br>CEP {site.postalCode}</p></div></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} Grupo ABR. Todos os direitos reservados.</span><span><a href="/politica-de-privacidade/">Privacidade</a> · <a href="/politica-de-cookies/">Cookies</a></span></div></footer>
<a class="float-wa" href={wa} target="_blank" rel="noopener" aria-label="Falar com o Grupo ABR pelo WhatsApp"><Icon name="whatsapp" size={28} brand /></a>
<script>
  const btn=document.querySelector('.menu-toggle'); const nav=document.querySelector('#main-nav'); btn?.addEventListener('click',()=>{const open=btn.getAttribute('aria-expanded')==='true';btn.setAttribute('aria-expanded',String(!open));nav?.classList.toggle('open',!open)});
  document.addEventListener('click',e=>{const a=(e.target as Element).closest('a');if(!a)return; if(a.href.includes('wa.me')) window.dataLayer?.push({event:'whatsapp_click',page_path:location.pathname,cta_code:new URL(a.href).searchParams.get('text')?.match(/Código: ([^.]+)/)?.[1]||'unknown'}); if(a.href.startsWith('tel:')) window.dataLayer?.push({event:'phone_click',page_path:location.pathname});});
  declare global { interface Window { dataLayer?: Record<string,unknown>[] } }
</script>
</body></html>

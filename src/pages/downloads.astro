---
import Base from '../layouts/Base.astro'; import {whatsappLink} from '../config'; const docs=[
 {title:'Política de Tratamento de Dados Pessoais',type:'Política',family:'Institucional',format:'PDF',url:'https://grupoabr.com.br/wp-content/uploads/2022/05/Politica-de-tratamento-de-dados-pessoais.pdf'},
 {title:'Política de Cookies',type:'Política',family:'Institucional',format:'PDF',url:'https://grupoabr.com.br/wp-content/uploads/2022/05/Politica-de-cookies.pdf'}];
---
<Base title="Downloads" description="Biblioteca de documentos e materiais oficiais do Grupo ABR."><header class="page-hero"><div class="container"><span class="eyebrow">Biblioteca</span><h1 class="display">Downloads e documentos</h1><p class="lead">Materiais reais, identificados por tipo e origem. Novas fichas e catálogos serão incluídos após validação documental.</p></div></header><section class="section"><div class="container"><div class="notice"><strong>Biblioteca em validação.</strong> Os catálogos técnicos e documentos MBP ainda dependem dos arquivos oficiais fornecidos pelo contratante. Nenhum PDF fictício foi publicado.</div><div style="margin-top:40px">{docs.map((d,i)=><article class="download"><div><span class="eyebrow">{d.family} · {d.type}</span><h2>{d.title}</h2><p>Documento oficial hospedado no domínio do Grupo ABR · {d.format}</p></div><div><a class="button outline" href={d.url} target="_blank" rel="noopener" data-download={d.title}>Abrir documento</a><a href={whatsappLink({interest:d.title,page:'downloads',position:'CTA do documento',code:`SITE-DOWNLOAD-${i+1}`})}>Atendimento relacionado →</a></div></article>)}</div></div></section><script>document.querySelectorAll('[data-download]').forEach(a=>a.addEventListener('click',()=>window.dataLayer?.push({event:'download_click',document_name:(a as HTMLElement).dataset.download,page_path:location.pathname})));</script></Base>

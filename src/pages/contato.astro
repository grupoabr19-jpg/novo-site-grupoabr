---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, whatsappLink } from '../config';

const mapsQuery = 'Rua João Simões de Carvalho 201-A Bloco B Cambuí MG';
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapsQuery)}`;
const mapsEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(mapsQuery)}&output=embed`;
---

<Base title="Contato" description="Fale com o Grupo ABR por WhatsApp, telefone ou e-mail.">
  <header class="page-hero">
    <div class="container">
      <span class="eyebrow">Fale conosco</span>
      <h1 class="display">Vamos organizar sua necessidade?</h1>
      <p class="lead">Para cotações, envie produto, medidas, quantidade e cidade de entrega.</p>
    </div>
  </header>

  <section class="section">
    <div class="container grid">
      <div class="family">
        <b>WhatsApp comercial</b>
        <h2>{site.whatsappDisplay}</h2>
        <p>Mensagem contextual para iniciar seu atendimento.</p>
        <a class="button" href={whatsappLink({interest:'atendimento comercial',page:'contato',position:'WhatsApp principal',code:'SITE-CONTATO-WA'})}><Icon name="whatsapp" size={18} brand /> Abrir WhatsApp</a>
      </div>
      <div class="family">
        <b>Ligação</b>
        <h2>{site.phoneDisplay}</h2>
        <p>Canal telefônico do Grupo ABR.</p>
        <a class="button outline" href={site.phoneHref}><Icon name="phone" size={18} /> Ligar agora</a>
      </div>
      <div class="family">
        <b>E-mail</b>
        <h2>{site.email}</h2>
        <p>Para contatos institucionais e documentação.</p>
        <a class="link-with-icon" href={`mailto:${site.email}`}>Enviar e-mail <Icon name="mail" size={17} /></a>
      </div>
    </div>
  </section>

  <section class="section soft contact-location">
    <div class="container contact-location-grid">
      <div class="contact-address">
        <span class="eyebrow">Matriz — Cambuí</span>
        <h2>{site.address}</h2>
        <p>CEP {site.postalCode}. O endereço da unidade de Pinheiral será publicado separadamente após confirmação.</p>
        <a class="button outline" href={mapsUrl} target="_blank" rel="noopener noreferrer"><Icon name="map-pin" size={18} /> Abrir rota no Google Maps</a>
      </div>
      <div class="contact-map">
        <iframe
          src={mapsEmbedUrl}
          title="Localização da matriz do Grupo ABR em Cambuí"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>
</Base>

---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { articles } from '../../data/content';
import { whatsappLink } from '../../config';
export function getStaticPaths() {
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}
const { article } = Astro.props;
const topics:Record<string,string[]>={
 'telha-pir-ou-eps':['Comece pelos requisitos do projeto','Compare o núcleo sem esquecer as faces','Peça documentação e uma proposta discriminada'],
 'como-solicitar-orcamento-de-telhas':['Identifique o perfil e a composição','Informe medidas e quantidade','Inclua acabamento, acessórios e destino'],
 'perfil-u-simples-e-enrijecido':['A diferença está na seção','Espessura e dimensões importam','O projeto define a aplicação'],
 'tubo-metalon-e-barra-macica':['Seção vazada ou maciça','Formato não define sozinho o produto','Como descrever na cotação'],
 'bobininha-e-bobina-slitada':['Entenda o formato de fornecimento','Informe largura, espessura e peso','Considere o equipamento de destino'],
 'transporte-e-armazenamento-de-telhas':['Planeje descarga e apoio','Proteja da umidade acumulada','Evite arraste e contato inadequado'],
 'comprar-chapas-de-aco':['Defina o tipo de material','Confirme espessura e dimensões','Descreva acabamento e processamento'],
 'lista-de-materiais-para-cotacao':['Padronize a descrição','Separe medidas de quantidades','Revise antes de enviar']}; const sections=topics[article.slug];
---
<Base title={article.title} description={article.summary}><header class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Início</a> / <a href="/blog/">Blog</a> / {article.title}</div><span class="eyebrow">{article.category}</span><h1 class="display">{article.title}</h1><p class="lead">{article.summary}</p><small>Por Grupo ABR · Publicado em 16/10/2026</small></div></header><section class="section"><div class="container product-layout"><article class="content"><p class="lead">Uma boa compra começa quando a necessidade é traduzida em informações que podem ser conferidas. Este guia organiza os principais pontos para conversar com fornecedores e responsáveis pelo projeto.</p>{sections.map((s:string,i:number)=><Fragment><h2>{s}</h2><p>{i===0?'Antes de comparar alternativas, registre a aplicação, as condições de uso e o que o projeto já especifica. Nomes comerciais parecidos podem representar geometrias, materiais ou composições diferentes.':i===1?'Medidas nominais, espessuras, revestimentos e acabamentos devem aparecer de forma separada. Isso reduz ambiguidades e ajuda o atendimento a verificar a opção disponível.':'Envie a lista com unidade de medida, quantidade e cidade de entrega. Quando houver projeto, desenho ou memorial, mantenha a identificação do documento e confirme a revisão utilizada.'}</p></Fragment>)}<h2>Checklist para a conversa comercial</h2><ul><li>Produto e aplicação</li><li>Medidas, espessura e acabamento</li><li>Quantidade e unidade de medida</li><li>Cidade de entrega</li><li>Referência do projeto, quando houver</li></ul><p class="notice">Este conteúdo é informativo e não substitui projeto, cálculo ou orientação de responsável técnico.</p><h2>Leia também</h2><a class="link-with-icon" href="/blog/">Ver todos os conteúdos do Grupo ABR <Icon name="arrow-right" size={17} /></a></article><aside><div class="quote-box"><span class="eyebrow">Ficou com uma dúvida?</span><h2>Converse sobre este assunto.</h2><p>Abra o WhatsApp com o tema do artigo já identificado.</p><a class="button" href={whatsappLink({interest:article.title,page:`artigo ${article.title}`,position:'CTA lateral',code:`SITE-BLOG-${article.slug.toUpperCase().slice(0,14)}`})}><Icon name="whatsapp" size={18} brand /> Falar com atendimento</a></div></aside></div></section></Base>

---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { families, articles } from '../data/content';
import { whatsappLink } from '../config';

const slides = [
  { id:'PIR', title:'Seu parceiro de aço para construir, fabricar e crescer.', text:'Desde 2008, o Grupo ABR fornece aço, coberturas e soluções para empresas, obras e profissionais em todo o Brasil.', label:'Falar com um especialista', interest:'produtos do Grupo ABR', href:'/empresa/', image:'/images/heroes/img-3019.jpg', position:'center' },
  { id:'EPS', title:'Coberturas que protegem o investimento da sua obra.', text:'Telhas metálicas, EPS, PIR, translúcidas e tipo forro com orientação para escolher a composição adequada ao projeto.', label:'Conhecer telhas', interest:'telhas', href:'/produtos/telhas/', image:'/images/heroes/img-2844.jpg', position:'center' },
  { id:'LONGOS', title:'Aços longos para construir, fabricar e transformar.', text:'Barras chatas, quadradas e redondas, cantoneiras e ferro T para construção civil, indústria e serralheria.', label:'Conhecer laminados', interest:'laminados', href:'/produtos/laminados/', image:'/images/heroes/img-2845.jpg', position:'center' },
  { id:'PLANOS', title:'Aço plano pronto para o próximo processo.', text:'Bobinas cortadas longitudinalmente para abastecer fabricação e transformação industrial.', label:'Conhecer bobina slitada', interest:'bobina slitada', href:'/produtos/bobina-slitada/', image:'/images/heroes/img-2841.jpg', position:'center' }
];

const testimonials = [
  { initials: 'EA', quote: 'Os principais motivos que compramos quase 100% do que precisamos nas estufas é preço, formas de pagamento, compromisso com a entrega. O pós-venda também é nota 1000, visitam a gente, perguntam se está certinho.', name: 'Elivelton Silvério de Almeida', role: 'Produtor de Morango de Senador Amaral, MG' },
  { initials: 'SC', quote: 'Entrega no prazo, ótimo atendimento, tanto no comercial, quanto na logística. Fico sempre muito grato a essa equipe do Grupo ABR.', name: 'Sebastião Conceição', role: 'Cliente final' },
  { initials: 'EJ', quote: 'Entrega excelente, vendedores atenciosos, pós-venda, resolução rápida de qualquer pedido nosso. Os vendedores são treinados para que saibam o que oferecer para cada caso nosso.', name: 'Eder Japão', role: 'Serralheria Santo Antônio' },
];

const clients = [
  { name: 'Cimed', image: '/images/clients/cimed.png', url: 'https://cimedremedios.com.br/' },
  { name: 'Heineken', image: '/images/clients/heineken.png', url: 'https://www.heinekenbrasil.com.br/' },
  { name: 'União Química', image: '/images/clients/uniao-quimica.png', url: 'https://www.uniaoquimica.com.br/' },
  { name: 'Multilaser', image: '/images/clients/multilaser.png', url: 'https://www.multilaser.com.br/' },
  { name: 'Adubos Real', image: '/images/clients/adubos-real.png', url: 'https://www.adubosreal.com.br/' },
  { name: 'DeSteel', image: '/images/clients/desteel.png', url: 'https://www.desteel-acos.com.br/' },
  { name: 'Ferros e Aços Guaçu', image: '/images/clients/ferros-guacu.png', url: 'https://fag.ind.br/' },
  { name: 'Costa e Vicente', image: '/images/clients/costa e vicente.png', url: 'https://costaevicente.com.br/' },
  { name: 'Mebras Metais', image: '/images/clients/mebras metais.png', url: 'https://mebrasltda.com/' },
  { name: 'Gehfer', image: '/images/clients/gehfer.png', url: 'https://gehfer.com.br/' },
  { name: 'Só Condutores', image: '/images/clients/so condutores.png', url: 'https://socondutores.com.br/' }
];
---
<Base title="Grupo ABR" description="Grupo ABR: seu Parceiraço em aço, telhas, bobinas, chapas, perfis, tubos e estruturas. Atendimento, logística e soluções para construção e indústria desde 2008.">
<section class="hero" aria-roledescription="carrossel" aria-label="Soluções em destaque"><div class="slides">
 {slides.map((s,i)=><article class:list={['slide',{active:i===0}]} style={`--hero-image:url('${s.image}');--hero-position:${s.position}`} data-slide={i} aria-hidden={i!==0}><div class="container"><span class="eyebrow">Grupo ABR · Seu Parceiraço</span><h1 class="display">{s.title}</h1><p class="lead">{s.text}</p><div class="actions"><a class="button" href={whatsappLink({interest:s.interest,page:`página inicial, banner ${s.id}`,position:'CTA principal do carrossel',code:`SITE-HOME-${s.id}`})} target="_blank" rel="noopener">{s.label}</a><a class="button secondary" href={s.href}>Conhecer a solução</a></div></div></article>)}
 <div class="slider-ui"><button class="prev" aria-label="Slide anterior"><Icon name="chevron-left" /></button>{slides.map((_,i)=><button class:list={['dot',{on:i===0}]} aria-label={`Ir para slide ${i+1}`} data-to={i}></button>)}<button class="next" aria-label="Próximo slide"><Icon name="chevron-right" /></button><button class="pause" aria-label="Pausar rotação" data-state="playing"><Icon name="pause" /></button></div>
</div></section>
<section class="home-actionbar" aria-label="Acessos rápidos"><div class="container">
  <a class="home-task" href="/produtos/"><small><Icon name="search" size={16} /> Catálogo</small><strong>Encontre o produto certo</strong><Icon name="arrow-up-right" /></a>
  <a class="home-task" href={whatsappLink({interest:'uma cotação',page:'home, acessos rápidos',position:'atalho de orçamento',code:'SITE-HOME-ATALHO-COTAR'})} target="_blank" rel="noopener"><small><Icon name="message-circle" size={16} /> Atendimento</small><strong>Converse com um especialista</strong><Icon name="arrow-up-right" /></a>
  <a class="home-task" href="/downloads/"><small><Icon name="file-text" size={16} /> Documentos</small><strong>Acesse materiais técnicos</strong><Icon name="arrow-up-right" /></a>
  <a class="home-task" href="/empresa/"><small><Icon name="building" size={16} /> Grupo ABR</small><strong>Conheça nossa história</strong><Icon name="arrow-up-right" /></a>
</div></section>
<section class="section home-intro"><div class="container split"><div class="home-intro-copy"><span class="eyebrow">Grupo ABR desde 2008</span><h2 class="title"><span>Conhecimento em aço.</span><span>Proximidade no atendimento.</span></h2><p class="lead">O Grupo ABR conecta portfólio, transformação, orientação comercial e logística para atender quem constrói, fabrica e distribui. Somos um Parceiraço para organizar a compra do material certo, com clareza desde a especificação até a entrega.</p><p>Atendemos construção civil, serralheria, indústria, agronegócio e empresas de cobertura com telhas, aços planos e longos, perfis, tubos, malhas, treliças e estruturas para energia solar.</p><a class="button outline" href="/empresa/">Conheça o Grupo ABR</a></div><figure class="home-intro-photo"><img src="/images/home/grupoabr-heloa-leite-home.webp" alt="Heloá Leite, consultora comercial do Grupo ABR" width="750" height="750" loading="lazy" /></figure></div></section>
<section class="section soft"><div class="container"><span class="eyebrow">Por que ser Parceiraço</span><h2 class="title">Uma relação construída para facilitar sua operação.</h2><div class="compare"><div><Icon name="truck" size={22} /><h3>Entrega e logística</h3><p>Frota própria ou parceiros logísticos para organizar prazos, cidades de entrega e o fluxo do seu material.</p></div><div><Icon name="message-circle" size={22} /><h3>Atendimento humanizado</h3><p>Equipe comercial preparada para entender aplicação, medidas, quantidade e orientar a cotação.</p></div><div><Icon name="check" size={22} /><h3>Tradição e inovação</h3><p>Desde 2008, o Grupo ABR amplia seu portfólio e busca soluções mais eficientes para cada cliente.</p></div></div></div></section>
<section class="section soft home-catalog"><div class="container"><span class="eyebrow">Catálogo</span><h2 class="title">A solução começa pelo material certo.</h2><p class="lead">Explore as principais famílias de produtos do Grupo ABR e encontre o caminho mais objetivo para sua necessidade.</p><div class="grid">{families.map(f=><a class="family" href={f[1]}><div class="card-icon"><Icon name={f[3]} size={21} /></div><h3>{f[0]}</h3><p>{f[2]}</p></a>)}<a class="catalog-specialist-card" href={whatsappLink({interest:'falar com um especialista sobre os produtos do Grupo ABR',page:'home, catálogo de produtos',position:'card Fale com um especialista',code:'SITE-HOME-CATALOGO-ESPECIALISTA'})} target="_blank" rel="noopener" aria-label="Falar com um especialista do Grupo ABR pelo WhatsApp"><small>Atendimento</small><strong>Fale com um especialista</strong><span>Conversar no WhatsApp <Icon name="arrow-up-right" size={18} /></span></a></div></div></section>
<section class="section pir-highlight"><div class="container split"><figure class="product-feature-photo"><img src="/images/products/pilha-telhas-pir.png" alt="Pilha de telhas PIR Isoblock MBP armazenadas para cobertura" width="1277" height="1231" loading="lazy" /></figure><div><span class="eyebrow">Destaque Grupo ABR</span><h2 class="title">Telhas</h2><p class="lead">As telhas do Grupo ABR são produzidas de acordo com os padrões e as normas vigentes, com qualidade e durabilidade para coberturas e fechamentos.</p><div class="actions"><a class="button pir-primary" href="/produtos/telhas/">Saiba mais <Icon name="arrow-right" size={18} /></a><a class="button pir-vendor" href={whatsappLink({interest:'telhas e coberturas',page:'home, destaque PIR',position:'CTA da seção',code:'SITE-HOME-PIR-VENDEDOR'})}>Fale com vendedor <Icon name="arrow-right" size={18} /></a></div></div></div></section>
<section class="section"><div class="container"><span class="eyebrow">Grupo ABR em números</span><h2 class="title">Uma operação preparada para acompanhar seu negócio.</h2><p class="lead">Mais de uma década conectando estoque, transformação, atendimento e logística para entregar aço com previsibilidade.</p><div class="stats"><div class="stat"><strong>2008</strong><span>início das atividades em Cambuí, Minas Gerais</span></div><div class="stat"><strong>25 mil+</strong><span>clientes atendidos em diferentes segmentos</span></div><div class="stat"><strong>3 mil+</strong><span>cidades alcançadas pela operação comercial e logística</span></div></div></div></section>
<section class="section soft home-contact-cta"><div class="container split"><div><span class="eyebrow">Atendimento comercial</span><h2 class="title">Conte o que você precisa. A gente organiza a cotação.</h2><p class="lead">Envie produto, medidas, quantidade e cidade de entrega. Nosso time ajuda a transformar a necessidade da obra ou da fábrica em uma solicitação objetiva.</p></div><div class="home-contact-action"><figure><img src="/images/home/equipe-atendimento-grupoabr.png" alt="Equipe comercial do Grupo ABR realizando atendimentos" width="630" height="711" loading="lazy" /></figure><a class="button" href={whatsappLink({interest:'produtos do Grupo ABR',page:'home, CTA final',position:'CTA final',code:'SITE-HOME-FINAL'})} target="_blank" rel="noopener">Falar com atendimento</a></div></div></section>
<section class="clients-section" aria-labelledby="clientes-titulo"><div class="container"><span class="eyebrow">Clientes</span><h2 id="clientes-titulo" class="title">Empresas que confiam no Grupo ABR.</h2><p class="clients-intro">Uma seleção de parceiros atendidos pelo nosso time comercial e pela nossa operação de aço, cobertura e logística.</p><div class="clients-carousel" role="region" aria-label="Carrossel de clientes"><div class="clients-track">{clients.map(client => <a class="client-logo" href={client.url} target="_blank" rel="noopener" aria-label={`Visitar o site de ${client.name}`}><img src={client.image} alt={`Logo ${client.name}`} width="520" height="220" loading="lazy" /></a>)}</div></div></div></section>
<section class="section"><div class="container"><span class="eyebrow">Conteúdo técnico</span><h2 class="title">Informação para decidir melhor.</h2><div class="grid">{articles.slice(0,3).map(a=><a class="family" href={`/blog/${a.slug}/`}><b>{a.category}</b><h3>{a.title}</h3><p>{a.summary}</p><span class="link-with-icon">Ler artigo <Icon name="arrow-right" size={17} /></span></a>)}</div><div class="actions"><a class="button outline" href="/blog/">Ver todos os artigos</a><a class="button outline" href="/downloads/">Acessar downloads</a></div></div></section>
<section class="testimonials-section" aria-labelledby="depoimentos-titulo"><div class="container"><span class="eyebrow">Clientes e parceiros</span><h2 id="depoimentos-titulo" class="title">Depoimentos</h2><div class="testimonials-carousel"><button class="testimonial-nav testimonial-prev" type="button" aria-label="Depoimento anterior"><Icon name="chevron-left" size={20} /></button><div class="testimonial-stage"><div class="testimonial-backdrop" aria-hidden="true"></div><div class="testimonial-card"><div class="testimonial-avatar" aria-hidden="true">EA</div><blockquote></blockquote><strong></strong><span></span></div></div><button class="testimonial-nav testimonial-next" type="button" aria-label="Próximo depoimento"><Icon name="chevron-right" size={20} /></button></div><div class="testimonial-dots" role="tablist" aria-label="Selecionar depoimento">{testimonials.map((_, i) => <button type="button" role="tab" aria-label={`Depoimento ${i + 1}`} class:list={{ active: i === 0 }} data-testimonial-dot={i}></button>)}</div></div></section>
<script>
const slides=[...document.querySelectorAll<HTMLElement>('.slide')],dots=[...document.querySelectorAll<HTMLElement>('.dot')];let current=0,paused=false,timer:number;
function show(n:number){current=(n+slides.length)%slides.length;slides.forEach((el,i)=>{el.classList.toggle('active',i===current);el.setAttribute('aria-hidden',String(i!==current))});dots.forEach((el,i)=>el.classList.toggle('on',i===current))}
function play(){clearInterval(timer);if(!paused&&!matchMedia('(prefers-reduced-motion: reduce)').matches)timer=window.setInterval(()=>show(current+1),8000)}
document.querySelector('.next')?.addEventListener('click',()=>{show(current+1);play()});document.querySelector('.prev')?.addEventListener('click',()=>{show(current-1);play()});dots.forEach((d,i)=>d.addEventListener('click',()=>{show(i);play()}));document.querySelector('.pause')?.addEventListener('click',e=>{paused=!paused;const button=e.currentTarget as HTMLElement;button.dataset.state=paused?'paused':'playing';button.setAttribute('aria-label',paused?'Retomar rotação':'Pausar rotação');const icon=button.querySelector<HTMLElement>('.site-icon');if(icon)icon.style.setProperty('--icon-source',`url('/icons/ui/${paused?'play':'pause'}.svg')`);play()});play();
</script>
<script>const clientTrack=document.querySelector<HTMLElement>('.clients-track');if(clientTrack)[...clientTrack.children].forEach(item=>{const clone=item.cloneNode(true) as HTMLElement;clone.setAttribute('aria-hidden','true');clone.setAttribute('tabindex','-1');clientTrack.append(clone)});</script>
<script>
  const testimonialData = [
    { initials: 'EA', quote: 'Os principais motivos que compramos quase 100% do que precisamos nas estufas é preço, formas de pagamento, compromisso com a entrega. O pós-venda também é nota 1000, visitam a gente, perguntam se está certinho.', name: 'Elivelton Silvério de Almeida', role: 'Produtor de Morango de Senador Amaral, MG' },
    { initials: 'SC', quote: 'Entrega no prazo, ótimo atendimento, tanto no comercial, quanto na logística. Fico sempre muito grato a essa equipe do Grupo ABR.', name: 'Sebastião Conceição', role: 'Cliente final' },
    { initials: 'EJ', quote: 'Entrega excelente, vendedores atenciosos, pós-venda, resolução rápida de qualquer pedido nosso. Os vendedores são treinados para que saibam o que oferecer para cada caso nosso.', name: 'Eder Japão', role: 'Serralheria Santo Antônio' },
  ];
  let testimonialIndex = 0;
  const testimonialCard = document.querySelector<HTMLElement>('.testimonial-card');
  const testimonialDots = [...document.querySelectorAll<HTMLButtonElement>('[data-testimonial-dot]')];
  function showTestimonial(index: number) {
    testimonialIndex = (index + testimonialData.length) % testimonialData.length;
    const item = testimonialData[testimonialIndex];
    if (!testimonialCard) return;
    testimonialCard.querySelector('.testimonial-avatar')!.textContent = item.initials;
    testimonialCard.querySelector('blockquote')!.textContent = item.quote;
    testimonialCard.querySelector('strong')!.textContent = item.name;
    testimonialCard.querySelector('span')!.textContent = item.role;
    testimonialDots.forEach((dot, i) => dot.classList.toggle('active', i === testimonialIndex));
  }
  document.querySelector('.testimonial-prev')?.addEventListener('click', () => showTestimonial(testimonialIndex - 1));
  document.querySelector('.testimonial-next')?.addEventListener('click', () => showTestimonial(testimonialIndex + 1));
  testimonialDots.forEach((dot, i) => dot.addEventListener('click', () => showTestimonial(i)));
  showTestimonial(0);
</script>
</Base>

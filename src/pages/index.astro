---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { families, articles } from '../data/content';
import { whatsappLink } from '../config';
const slides=[
 {id:'PIR',title:'Telhas PIR para projetos que exigem eficiência térmica.',text:'Conheça soluções para coberturas e encontre a configuração adequada à sua obra com o Grupo ABR.',label:'Cotar telhas PIR',interest:'telhas PIR',href:'/produtos/telhas-pir/'},
 {id:'EPS',title:'Mais conforto para sua cobertura com telhas sanduíche EPS.',text:'Conheça as opções de acabamento e solicite uma cotação conforme as medidas do seu projeto.',label:'Cotar telhas EPS',interest:'telhas sanduíche EPS',href:'/produtos/telhas-sanduiche-eps/'},
 {id:'LONGOS',title:'Aços longos para construir, fabricar e transformar.',text:'Vergalhões, barras, cantoneiras e vigas para diferentes necessidades da construção e da indústria.',label:'Cotar aços longos',interest:'aços longos',href:'/produtos/acos-longos-e-laminados/'},
 {id:'PLANOS',title:'Bobinas e chapas para a necessidade da sua produção.',text:'Materiais e possibilidades de corte para diferentes aplicações industriais e comerciais.',label:'Cotar bobinas e chapas',interest:'bobinas e chapas',href:'/produtos/bobinas-e-chapas/'}
];
---
<Base title="Grupo ABR" description="Soluções em aço, telhas, bobinas, chapas, perfis, tubos e estruturas para construção e indústria.">
<section class="hero" aria-roledescription="carrossel" aria-label="Soluções em destaque"><div class="slides">
 {slides.map((s,i)=><article class:list={['slide',{active:i===0}]} data-slide={i} aria-hidden={i!==0}><div class="container"><span class="eyebrow">Soluções em aço</span><h1 class="display">{s.title}</h1><p class="lead">{s.text}</p><div class="actions"><a class="button" href={whatsappLink({interest:s.interest,page:`página inicial, banner ${s.id}`,position:'CTA principal do carrossel',code:`SITE-HOME-${s.id}`})} target="_blank" rel="noopener">{s.label}</a><a class="button secondary" href={s.href}>Conhecer a solução</a></div></div></article>)}
 <div class="slider-ui"><button class="prev" aria-label="Slide anterior"><Icon name="chevron-left" /></button>{slides.map((_,i)=><button class:list={['dot',{on:i===0}]} aria-label={`Ir para slide ${i+1}`} data-to={i}></button>)}<button class="next" aria-label="Próximo slide"><Icon name="chevron-right" /></button><button class="pause" aria-label="Pausar rotação" data-state="playing"><Icon name="pause" /></button></div>
</div></section>
<section class="home-actionbar" aria-label="Acessos rápidos"><div class="container">
  <a class="home-task" href="/produtos/"><small><Icon name="search" size={16} /> Catálogo</small><strong>Encontre o produto certo</strong><Icon name="arrow-up-right" /></a>
  <a class="home-task" href={whatsappLink({interest:'uma cotação',page:'home, acessos rápidos',position:'atalho de orçamento',code:'SITE-HOME-ATALHO-COTAR'})} target="_blank" rel="noopener"><small><Icon name="message-circle" size={16} /> Atendimento</small><strong>Comece uma cotação</strong><Icon name="arrow-up-right" /></a>
  <a class="home-task" href="/downloads/"><small><Icon name="file-text" size={16} /> Documentos</small><strong>Acesse materiais técnicos</strong><Icon name="arrow-up-right" /></a>
  <a class="home-task" href="/empresa/"><small><Icon name="building" size={16} /> Grupo ABR</small><strong>Conheça nossa operação</strong><Icon name="arrow-up-right" /></a>
</div></section>
<section class="section"><div class="container split"><div><span class="eyebrow">Seu Parceiraço</span><h2 class="title">Aço, aplicação e logística no mesmo diálogo.</h2><p class="lead">O Grupo ABR atende construção, serralheria, indústria, agronegócio e empresas de cobertura com um portfólio organizado e orientação comercial para cada necessidade.</p><a class="button outline" href="/empresa/">Conheça o Grupo ABR</a></div><div class="industrial-art" role="img" aria-label="Representação gráfica de chapas metálicas perfiladas"></div></div></section>
<section class="section soft"><div class="container"><span class="eyebrow">Catálogo</span><h2 class="title">Encontre pelo que você vai construir.</h2><div class="grid">{families.map(f=><a class="family" href={f[1]}><div class="card-icon"><Icon name={f[3]} size={21} /></div><h3>{f[0]}</h3><p>{f[2]}</p><span class="link-with-icon">Explorar família <Icon name="arrow-right" size={17} /></span></a>)}</div></div></section>
<section class="section dark"><div class="container split"><div class="industrial-art" role="img" aria-label="Representação técnica de painel metálico termoisolante"></div><div><span class="eyebrow">Destaque</span><h2 class="title">Telhas PIR: eficiência começa na especificação.</h2><p class="lead">Faces metálicas e núcleo rígido de PIR formam uma solução industrializada para coberturas. Perfil, espessura, acabamento e detalhes de montagem precisam conversar com o projeto.</p><div class="actions"><a class="button" href="/produtos/telhas-pir/">Conhecer telhas PIR</a><a class="button secondary" href={whatsappLink({interest:'telhas PIR',page:'home, destaque PIR',position:'CTA da seção',code:'SITE-HOME-PIR-DESTAQUE'})}>Cotar telhas PIR</a></div></div></div></section>
<section class="section"><div class="container"><span class="eyebrow">Escolha da cobertura</span><h2 class="title">Três composições. Critérios diferentes.</h2><div class="compare"><div><h3>Metálica simples</h3><p>Indicada quando o projeto pede uma pele metálica sem núcleo isolante. Avalie perfil, vão, inclinação, revestimento e acabamento.</p></div><div><h3>Sanduíche EPS</h3><p>Integra núcleo de poliestireno expandido. A decisão considera desempenho esperado, faces e acabamento inferior.</p></div><div><h3>Telha PIR</h3><p>Usa núcleo rígido de poliisocianurato. Consulte a documentação do fabricante e a configuração adequada ao projeto.</p></div></div></div></section>
<section class="band"><div class="container"><strong>Vai cotar?</strong><p>Tenha produto, medidas, quantidade e cidade de entrega em mãos.</p><a class="button outline" href={whatsappLink({interest:'uma cotação de aço',page:'home, faixa de orientação',position:'CTA intermediário',code:'SITE-HOME-COTAR'})}>Iniciar pelo WhatsApp</a></div></section>
<section class="section dark"><div class="container"><span class="eyebrow">Capacidade e operação</span><h2 class="title">Duas unidades. Um atendimento conectado à sua necessidade.</h2><p class="lead">Desde 2008, o Grupo ABR desenvolve sua operação em Cambuí, Minas Gerais, e Pinheiral, Rio de Janeiro. Estoque, transformação e logística apoiam o fornecimento de produtos em aço.</p><div class="stats"><div class="stat"><strong>2008</strong><span>início das atividades em Cambuí</span></div><div class="stat"><strong>Cambuí — MG</strong><span>matriz e operação industrial</span></div><div class="stat"><strong>Pinheiral — RJ</strong><span>unidade dedicada ao atendimento regional</span></div></div></div></section>
<section class="section"><div class="container"><span class="eyebrow">Conteúdo técnico</span><h2 class="title">Informação para decidir melhor.</h2><div class="grid">{articles.slice(0,3).map(a=><a class="family" href={`/blog/${a.slug}/`}><b>{a.category}</b><h3>{a.title}</h3><p>{a.summary}</p><span class="link-with-icon">Ler artigo <Icon name="arrow-right" size={17} /></span></a>)}</div><div class="actions"><a class="button outline" href="/blog/">Ver todos os artigos</a><a class="button outline" href="/downloads/">Acessar downloads</a></div></div></section>
<section class="section soft"><div class="container split"><div><span class="eyebrow">Próximo passo</span><h2 class="title">Conte o que você precisa. A gente ajuda a organizar a cotação.</h2><p class="lead">Envie o produto, as medidas, a quantidade e a cidade de entrega pelo WhatsApp.</p></div><a class="button" href={whatsappLink({interest:'produtos do Grupo ABR',page:'home, CTA final',position:'CTA final',code:'SITE-HOME-FINAL'})}>Falar com atendimento comercial</a></div></section>
<script>
const slides=[...document.querySelectorAll<HTMLElement>('.slide')],dots=[...document.querySelectorAll<HTMLElement>('.dot')];let current=0,paused=false,timer:number;
function show(n:number){current=(n+slides.length)%slides.length;slides.forEach((el,i)=>{el.classList.toggle('active',i===current);el.setAttribute('aria-hidden',String(i!==current))});dots.forEach((el,i)=>el.classList.toggle('on',i===current))}
function play(){clearInterval(timer);if(!paused&&!matchMedia('(prefers-reduced-motion: reduce)').matches)timer=window.setInterval(()=>show(current+1),8000)}
document.querySelector('.next')?.addEventListener('click',()=>{show(current+1);play()});document.querySelector('.prev')?.addEventListener('click',()=>{show(current-1);play()});dots.forEach((d,i)=>d.addEventListener('click',()=>{show(i);play()}));document.querySelector('.pause')?.addEventListener('click',e=>{paused=!paused;const button=e.currentTarget as HTMLElement;button.dataset.state=paused?'paused':'playing';button.setAttribute('aria-label',paused?'Retomar rotação':'Pausar rotação');const icon=button.querySelector<HTMLElement>('.site-icon');if(icon)icon.style.setProperty('--icon-source',`url('/icons/ui/${paused?'play':'pause'}.svg')`);play()});play();
</script>
</Base>

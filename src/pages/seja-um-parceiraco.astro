import Base from '../layouts/Base.astro'; import {whatsappLink} from '../config';
---
<Base title="Seja um Parceiraço" description="Converse com o Grupo ABR sobre relacionamento comercial."><header class="page-hero"><div class="container"><span class="eyebrow">Relacionamento</span><h1 class="display">Seja um Parceiraço</h1><p class="lead">Conte sobre sua empresa, os produtos de interesse e a região de atendimento.</p></div></header><section class="section"><div class="container split"><div><h2 class="title">Uma conversa objetiva começa com contexto.</h2><p class="lead">Informe segmento, cidade, produtos de interesse e frequência estimada de compra. O atendimento indicará os próximos passos aplicáveis.</p></div><a class="button" href={whatsappLink({interest:'ser um Parceiraço do Grupo ABR',page:'Seja um Parceiraço',position:'CTA principal',code:'SITE-PARCEIRACO-TOPO'})}>Iniciar conversa</a></div></section></Base>

---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { products } from '../../data/content';
import { whatsappLink } from '../../config';
export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}
const {product}=Astro.props; const wa=whatsappLink({interest:product.quote,page:`página ${product.title}`,position:'orçamento principal',code:`SITE-${product.slug.toUpperCase().slice(0,18)}-TOPO`});
const related=products.filter((p:any)=>product.related.includes(p.slug));
---
<Base title={product.title} description={product.intro}>
<header class:list={['page-hero', {'has-product-photo': product.image}]}><div class="container product-hero-grid"><div><div class="breadcrumbs"><a href="/">Início</a> / <a href="/produtos/">Produtos</a> / {product.title}</div><span class="eyebrow">{product.eyebrow}</span><h1 class="display">{product.title}</h1><p class="lead">{product.intro}</p></div>{product.image && <figure class="product-hero-photo"><img src={product.image} alt={product.imageAlt} width="800" height="600" loading="eager" fetchpriority="high" /></figure>}</div></header>
<section class="section"><div class="container product-layout"><article class="content"><h2>O que é</h2><p>{product.description}</p><h2>Aplicações</h2><div class="chips">{product.applications.map((x:string)=><span class="chip">{x}</span>)}</div><h2>Benefícios para a especificação</h2><ul>{product.benefits.map((x:string)=><li>{x}</li>)}</ul><h2>Modelos e configurações</h2><div class="compare">{product.options.map((x:string)=><div><Icon name="check" size={18} /><p>{x}</p></div>)}</div><h2>O que informar para cotar</h2><p>Envie a denominação do produto, medidas, espessura ou modelo quando conhecidos, quantidade, acabamento e cidade de entrega. Se houver projeto ou lista de materiais, use-os como referência na conversa.</p>{product.note&&<p class="notice">{product.note}</p>}<h2>Perguntas frequentes</h2><div class="faq"><details><summary>Como escolher a configuração?</summary><p>A escolha parte da aplicação e do projeto. Reúna medidas, carregamentos ou desempenho esperado e confirme as opções disponíveis com o atendimento.</p></details><details><summary>O produto é vendido com instalação?</summary><p>Esta página apresenta o fornecimento do material. Escopo, logística e serviços devem ser confirmados na proposta comercial.</p></details><details><summary>Como pedir orçamento?</summary><p>Informe produto, medidas, quantidade e cidade de entrega. Quanto mais completa a lista, mais objetiva será a conferência.</p></details></div><h2>Produtos relacionados</h2><div class="grid">{related.map((p:any)=><a class="family" href={`/produtos/${p.slug}/`}><b>{p.family}</b><h3>{p.title}</h3><p>{p.intro}</p><span class="link-with-icon">Conhecer <Icon name="arrow-right" size={17} /></span></a>)}</div></article><aside><div class="quote-box"><span class="eyebrow">Cotação orientada</span><h2>Fale com o Grupo ABR</h2><p>Envie produto, medidas, quantidade e cidade de entrega.</p><a class="button" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} brand /> Solicitar orçamento</a><hr><small>O clique abre uma conversa no WhatsApp com uma mensagem preenchida. Você decide quando enviar.</small></div></aside></div></section>
</Base>

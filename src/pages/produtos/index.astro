---
import Base from '../../layouts/Base.astro'; import Icon from '../../components/Icon.astro'; import {families} from '../../data/content';
---
<Base title="Produtos e soluções" description="Conheça o catálogo de telhas, bobinas, chapas, aços longos, perfis, tubos, malhas, treliças e ABR Solar."><header class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Início</a> / Produtos</div><span class="eyebrow">Catálogo Grupo ABR</span><h1 class="display">Produtos para construir, fabricar e transformar.</h1><p class="lead">Navegue por família e encontre os dados necessários para iniciar uma cotação mais objetiva.</p></div></header><section class="section soft"><div class="container"><div class="grid">{families.map(f=><a class="family" href={f[1]}><div class="card-icon"><Icon name={f[3]} size={21} /></div><h2>{f[0]}</h2><p>{f[2]}</p><span class="link-with-icon">Ver produtos <Icon name="arrow-right" size={17} /></span></a>)}</div></div></section></Base>

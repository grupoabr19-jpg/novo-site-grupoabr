---
import Base from '../../layouts/Base.astro'; import Icon from '../../components/Icon.astro'; import {products} from '../../data/content'; const ids=['laminados','vergalhoes','vigas-w-e-i','malhas-de-aco','trelicas']; const list=products.filter(p=>ids.includes(p.slug));
---
<Base title="Aços longos e laminados" description="Barras, cantoneiras, vergalhões, vigas, malhas e treliças para construção e indústria."><header class="page-hero"><div class="container"><span class="eyebrow">Construir e fabricar</span><h1 class="display">Aços longos e laminados</h1><p class="lead">Seções maciças, perfis e armaduras convencionais organizados pela aplicação.</p></div></header><section class="section"><div class="container grid">{list.map(p=><a class="family" href={`/produtos/${p.slug}/`}><b>{p.eyebrow}</b><h2>{p.title}</h2><p>{p.intro}</p><span class="link-with-icon">Conhecer <Icon name="arrow-right" size={17} /></span></a>)}</div></section></Base>

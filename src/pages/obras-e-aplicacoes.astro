---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

const works = [
  { image: '/images/works/coberturas-industriais.png', title: 'Coberturas industriais', material: 'Estruturas metálicas', text: 'Soluções completas para galpões e grandes vãos, com montagem rápida e alta resistência.' },
  { image: '/images/works/coberturas-industriais-2.png', title: 'Estruturas para galpões', material: 'Aço estrutural', text: 'Perfis e componentes dimensionados para coberturas industriais e ampliações.' },
  { image: '/images/works/perfil-simples-enrijecido.png', title: 'Fechamentos e estruturas', material: 'Perfil U enrijecido', text: 'Perfis conformados para reforçar paredes, coberturas, mezaninos e sistemas de montagem.' },
  { image: '/images/works/perfil-simples-enrijecido-2.png', title: 'Montagem metálica', material: 'Perfis estruturais', text: 'Aço pronto para aplicação, com padronização e agilidade na montagem em campo.' },
  { image: '/images/works/perfil-simples-cantoneiras.png', title: 'Soluções leves', material: 'Perfil U simples', text: 'Perfis para fechamentos, divisórias e estruturas auxiliares em diferentes projetos.' },
  { image: '/images/works/perfil-simples-cantoneiras-2.png', title: 'Detalhes de montagem', material: 'Cantoneiras e perfis', text: 'Elementos versáteis para arremates, reforços e composição de estruturas metálicas.' },
  { image: '/images/works/perfil-simples-cantoneiras-3.png', title: 'Grandes vãos', material: 'Vigas W e I', text: 'Aços longos para vigas, pórticos e estruturas que precisam suportar grandes cargas.' },
  { image: '/images/works/vigas-w-i.png', title: 'Vigas para estruturas', material: 'Vigas W e I', text: 'Perfis laminados para aplicações estruturais com precisão, resistência e estabilidade.' },
  { image: '/images/works/telhas-metalicas.png', title: 'Cobertura metálica', material: 'Telha trapezoidal simples', text: 'Telhas para coberturas e fachadas com resistência, rapidez de instalação e acabamento uniforme.' },
  { image: '/images/works/telhas-metalicas-2.png', title: 'Proteção e acabamento', material: 'Telha de aço', text: 'Aplicações em obras comerciais, industriais e agrícolas que exigem durabilidade e desempenho.' },
  { image: '/images/works/telhas-termo.png', title: 'Conforto térmico', material: 'Telha termoacústica', text: 'Coberturas com isolamento para reduzir a troca de calor e melhorar o ambiente interno.' },
  { image: '/images/works/telhas-termo-2.png', title: 'Coberturas eficientes', material: 'Telha termoacústica', text: 'Sistemas de cobertura que combinam proteção, desempenho térmico e acabamento.' },
  { image: '/images/works/telhas-translucidas.png', title: 'Iluminação natural', material: 'Telha translúcida', text: 'Faixas translúcidas que aproveitam a luz do dia e ajudam a reduzir o consumo de energia.' },
  { image: '/images/works/vergalhoes.png', title: 'Armaduras para concreto', material: 'Vergalhões', text: 'Aços longos para fundações, pilares, vigas e demais elementos de concreto armado.' },
  { image: '/images/works/vergalhoes-2.png', title: 'Aço para fundações', material: 'Vergalhões e armaduras', text: 'Soluções cortadas e dobradas para organizar a execução e dar resistência à obra.' },
  { image: '/images/works/vergalhoes-3.png', title: 'Estruturas de concreto', material: 'Armaduras', text: 'Componentes de aço preparados para atender às necessidades de cada projeto estrutural.' },
];
---

<Base title="Obras e aplicações" description="Veja aplicações dos produtos do Grupo ABR em coberturas, estruturas, indústria e construção.">
  <header class="page-hero"><div class="container"><span class="eyebrow">Aplicações</span><h1 class="display">Do aço à obra.</h1><p class="lead">Conheça algumas aplicações dos materiais do Grupo ABR em coberturas, estruturas metálicas e soluções para construção.</p></div></header>
  <section class="section works-section"><div class="container">
    <div class="works-heading"><div><span class="eyebrow">Galeria de aplicações</span><h2 class="title">Materiais que ganham forma no projeto.</h2></div><p>Explore os projetos do Grupo ABR. Use as setas ou arraste para navegar.</p></div>
    <div class="works-carousel-wrap">
      <button class="works-nav works-nav-prev" type="button" aria-label="Aplicação anterior"><Icon name="chevron-left" size={19} /></button>
      <div class="works-carousel" aria-label="Carrossel de obras e aplicações">
        {works.map((work, index) => <article class="work-card" data-card-index={index}>
          <div class="work-image"><img src={work.image} alt={`${work.title} com ${work.material}`} loading={index < 3 ? 'eager' : 'lazy'} /><div class="work-overlay"><span>{work.material}</span><h3>{work.title}</h3><p>{work.text}</p><a href="/produtos/" class="link-with-icon">Conhecer produtos <Icon name="arrow-right" size={17} /></a></div></div>
        </article>)}
      </div>
      <button class="works-nav works-nav-next" type="button" aria-label="Próxima aplicação"><Icon name="chevron-right" size={19} /></button>
    </div>
    <div class="works-carousel-footer"><span class="works-counter" aria-live="polite">01 / {String(works.length).padStart(2, '0')}</span></div>
  </div></section>
</Base>

<script>
  const carousel = document.querySelector('.works-carousel');
  const cards = [...document.querySelectorAll('.work-card')];
  const counter = document.querySelector('.works-counter');
  const cardStep = () => cards[0]?.getBoundingClientRect().width + 24 || 0;
  const update = () => {
    if (!carousel || !cards.length) return;
    const index = Math.min(cards.length - 1, Math.max(0, Math.round(carousel.scrollLeft / cardStep())));
    if (counter) counter.textContent = `${String(index + 1).padStart(2, '0')} / ${String(cards.length).padStart(2, '0')}`;
  };
  document.querySelector('.works-nav-prev')?.addEventListener('click', () => carousel?.scrollBy({ left: -cardStep(), behavior: 'smooth' }));
  document.querySelector('.works-nav-next')?.addEventListener('click', () => carousel?.scrollBy({ left: cardStep(), behavior: 'smooth' }));
  carousel?.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
  update();
</script>
